# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.VSCodeCounter/
.idea/
*.swp
*.swo
*~

# Build outputs
*.o
*.d
*.a
*.so
*.elf
*.bin
# ...except the fuzzer corpus. The named seeds there are inputs that once found a
# real bug (bug_01_elf_integer_overflow.bin reproduces the ELF program-header
# integer overflow), so they are test data, not build output. Without this the
# blanket *.bin rule silently dropped them from the repo while the hash-named
# seeds beside them stayed tracked.
!tests/host/corpus/*.bin
*.img
*.iso
*.map
*.sym
*.lst

# Debug
*.log
/core
vgcore.*

# Coverage
*.gcda
*.gcno
*.gcov

# Generated directories
build/
out/
dist/
isodir/

# QEMU
*.qcow2
*.vmdk

# Temporary files
tmp/
temp/

# Environment
.env
.env.*

# Python
__pycache__/
*.py[cod]
*$py.class

# Compiled binaries
*.out

# Test binaries
tests/host/bin/

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# Sensitive
passwords.txt

# QEMU logs
qemu.log

# Generated test files
message.txt
gizli.txt

# Generated resource files
src/resources/*_data.c

# Local editor and agent tooling state. Machine-specific, not project config.
.claude/
.VSCodeCounter/
